APP_NAME="Brasileirão DB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Use o endereço direto do Neon, sem -pooler.
DB_HOST=ep-seu-endpoint.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=nelson_brasileirao_DB
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require
DB_SEARCH_PATH=nelson_brasileirao_db,public

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
